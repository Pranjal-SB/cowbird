# Sender for the delivery gate: packages/core/tests/test_delivery.py
#
# Optional. Without it, test_a_real_message_arrives_and_can_be_read still runs
# via sendtestemail.com (no account needed) and the OTP test skips. With it,
# both run and neither depends on a third party's rate limit.
#
# Any credentialed sender works: a Gmail app password, a free Brevo or SendGrid
# key, your own postfix. Copy this file to .env (gitignored) and fill it in.

COWBIRD_SMTP_HOST=smtp.gmail.com
COWBIRD_SMTP_PORT=587
COWBIRD_SMTP_USER=you@example.com
COWBIRD_SMTP_PASSWORD=your-app-password
COWBIRD_SMTP_FROM=you@example.com

# Where the health file lives. Defaults to a per-user data dir.
# COWBIRD_HEALTH_PATH=.cowbird-health.json
