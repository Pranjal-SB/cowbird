# Sender for the delivery gate: packages/core/tests/test_delivery.py
#
# Optional. Without it, test_a_real_message_arrives_and_can_be_read still runs
# via sendtestemail.com (no account needed) and the OTP test skips. With it,
# both run and neither depends on a third party's rate limit.
#
# Any credentialed sender works: a Gmail app password, a free Brevo or SendGrid
# key, your own postfix. Copy this file to .env (gitignored) and fill it in.

COWBIRD_SMTP_HOST=smtp.gmail.com
COWBIRD_SMTP_PORT=587
COWBIRD_SMTP_USER=you@example.com
COWBIRD_SMTP_PASSWORD=your-app-password
COWBIRD_SMTP_FROM=you@example.com

# Where the health file lives. Defaults to a per-user data dir.
# COWBIRD_HEALTH_PATH=.cowbird-health.json

# cowbird-server
API_KEYS=change-me,and-another
ALLOWED_ORIGINS=
RATE_LIMIT=30/minute
WAIT_MAX=25
WEBHOOK_SECRET=
WEBHOOK_ALLOW_PRIVATE=0
WEBHOOK_MAX=600

# Unset means addresses live in this process and are lost on restart, which is
# the single-instance deploy. Set it and several instances share one store.
# DATABASE_URL=postgresql://cowbird:cowbird@127.0.0.1:5432/cowbird
# Must be stable across restarts or this instance never finds its own health
# history again, and unique per process. Defaults to hostname-pid. A deploy
# running several workers off one command -- `uvicorn --workers 4`, gunicorn --
# must set it per worker, or they share one health row and overwrite each other.
# INSTANCE_ID=backend-1
# HEALTH_FLUSH_SECONDS=10
